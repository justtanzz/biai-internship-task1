# Security: NEVER upload environment variables or API keys
.env

# Virtual Environments (GitHub only needs requirements.txt, not the installed packages)
.venv/
venv/
env/

# Local Database (Render will use its own, we don't want to upload your local test data)
crm.db
*.sqlite3

# Python Cache (These are auto-generated files that just bloat the repository)
__pycache__/
*.py[cod]
*$py.class